{
  "_instruction": "Copy this file to appsettings.Development.json or update your environment variables for local development.",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost,1433;Database=EmployeeManagementDB;User Id=sa;Password=YourSecurePasswordHere!;TrustServerCertificate=True;"
  },
  "JwtSettings": {
    "SecretKey": "ReplaceWithASecretKeyAtLeast32CharactersLong!",
    "Issuer": "EmployeeManagementAPI",
    "Audience": "EmployeeManagementClient",
    "ExpiryInMinutes": 60
  },
  "Encryption": {
    "Key": "ReplaceWithAES256KeyAtLeast32CharactersLong!"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000", "http://127.0.0.1:5500", "http://localhost:5500", "null" ]
  }
}
